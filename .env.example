# MeetMind settings. Copy this file to .env and edit. Every value here is a safe local default.
# .env is git-ignored. This file must never contain real keys.

# Adapter switches. Each one picks an adapter in backend/app/config.py.
# "local" for Phases 0 to 3, "aws" from Phase 4.
STT_PROVIDER=local
LLM_PROVIDER=local
EMBEDDINGS_PROVIDER=local
STORE_PROVIDER=local
AUTH_PROVIDER=local
VECTOR_STORE_PROVIDER=local
DOCUMENT_PARSER_PROVIDER=local

# Backend. Listens on localhost only.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080

# DynamoDB Local runs in Docker on port 8000. In Phase 4 this line is removed and real DynamoDB is used.
DYNAMODB_ENDPOINT=http://localhost:8000
# When port 8000 is taken, move DynamoDB Local: DYNAMODB_PORT=8001 here and the endpoint above to port 8001.
AWS_REGION=us-east-1
# Prefix for every table name, so MeetMind tables are easy to spot in a real AWS account later.
TABLE_PREFIX=meetmind_

# Transcripts and cards expire after this many days (DynamoDB TTL). Audio is never stored at all.
RETENTION_DAYS=30
# Folder of test meetings (stereo 16 kHz WAV) that replay mode may play. Built by eval/generate_audio.py.
REPLAY_DIR=eval/audio

# Documents. Vectors live in this SQLite file (sqlite-vec, decision 0006). Chunks are about CHUNK_CHARS characters.
VECTOR_DB_PATH=data/vectors.db
CHUNK_CHARS=1200
CHUNK_OVERLAP_CHARS=150
MAX_DOCUMENT_MB=20

# Debug mode writes audio to disk. Off by default. Audio is never stored in normal use.
DEBUG_SAVE_AUDIO=false

# Ollama, the local LLM and embeddings server.
# LLM_PROVIDER=meta uses Meta's Model API (decision 0008, the Meta AI hackathon). Key from dev.meta.ai, API keys.
# With it, set LLM_CLASSIFIER_MODEL and LLM_ANSWER_MODEL to muse-spark-1.3. The key lives only in .env.
META_API_URL=https://api.meta.ai/v1
META_API_KEY=
META_REASONING_EFFORT=minimal
OLLAMA_URL=http://127.0.0.1:11434
# Keep models loaded between requests. A cold load costs 2 to 10 s on the M3 Pro, a warm first token under 0.1 s.
OLLAMA_KEEP_ALIVE=30m

# Model slots, picked in Step 0.2 for a 36 GB Mac. About 11 GB stays resident in total.
# Use GGUF builds (the -q4_K_M tags). Ollama's MLX builds cannot do schema-constrained JSON output.
# Llama alternatives for the Meta hackathon: llama3.2:3b (classifier) and llama3.1:8b (answer, doubt).
LLM_CLASSIFIER_MODEL=qwen3.5:4b-q4_K_M
LLM_ANSWER_MODEL=qwen3.5:9b-q4_K_M
LLM_DOUBT_MODEL=qwen3.5:9b-q4_K_M
EMBEDDINGS_MODEL=nomic-embed-text

# Speech-to-text, local adapter (Step 0.4, decision 0004). The whisper weights download from Hugging Face on first use.
STT_MODEL=mlx-community/whisper-small-mlx
# Language of the meeting, as a two letter code. Whisper transcribes it; English is the one the eval covers.
STT_LANGUAGE=en
VAD_MODEL_PATH=models/stt/silero_vad.onnx
# Silence that ends a turn, in milliseconds. Start at 600, tune with scripts/measure_turn_delay.py.
TURN_SILENCE_MS=600
# Detector A: how long an Attention press stays armed, and how long after you spoke a question with "you" or your topic still counts as aimed at you.
ATTENTION_WINDOW_S=15
AFTER_YOU_SPOKE_WINDOW_S=10
# Detector B keeps an alert only when the classifier is at least this sure (0 to 1).
CLASSIFIER_MIN_CONFIDENCE=0.5
# Answer agent: chunks pulled from your documents per question, and the least similarity (0 to 1) that counts as relevant.
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.45
CACHE_HIT_SCORE=0.75
# How much of the documents the claim checker reads whole, in characters; 0 switches it off (decision 0009).
# 40,000 fits the local model's 32K-token context. With LLM_PROVIDER=meta, Muse Spark can take far more.
CLAIM_CONTEXT_CHARS=40000
# Notes agent: how often the running meeting notes are rewritten, in seconds of audio.
NOTES_EVERY_S=180
# How often the partial transcript refreshes while someone is still talking.
STT_PARTIAL_EVERY_MS=1000
